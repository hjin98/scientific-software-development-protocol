new file mode 100644
index 0000000..a080c6b
--- /dev/null
+++ b/sigproc/rescale.py
@@ -0,0 +1,9 @@
+def rescale(values, low, high):
+    if not values:
+        raise ValueError("values must not be empty")
+    minimum = min(values)
+    maximum = max(values)
+    if minimum == maximum:
+        raise ValueError("values must not be constant")
+    scale = (high - low) / (maximum - minimum)
+    return [low + (value - minimum) * scale for value in values]
diff --git a/tests/test_rescale.py b/tests/test_rescale.py
new file mode 100644
index 0000000..11f2a83
--- /dev/null
+++ b/tests/test_rescale.py
@@ -0,0 +1,28 @@
+import unittest
+
+from sigproc.rescale import rescale
+
+
+class RescaleTests(unittest.TestCase):
+    def test_normal_range(self):
+        self.assertEqual(rescale([0, 5, 10], 0, 1), [0.0, 0.5, 1.0])
+
+    def test_negative_range(self):
+        self.assertEqual(rescale([0, 5, 10], -1, 1), [-1.0, 0.0, 1.0])
+
+    def test_constant_input_raises(self):
+        with self.assertRaises(ValueError):
+            rescale([3, 3, 3], 0, 1)
+
+    def test_empty_input_raises(self):
+        with self.assertRaises(ValueError):
+            rescale([], 0, 1)
+
+    def test_input_list_unchanged(self):
+        values = [0, 5, 10]
+        rescale(values, 0, 1)
+        self.assertEqual(values, [0, 5, 10])
+
+
+if __name__ == "__main__":
+    unittest.main()
