{
  "schema": 1,
  "profile_id": "claude-evaluator-readonly-reference-template",
  "adapter_id": "claude-stream-json-v2",
  "agent_model": "claude-sonnet-5",
  "provider_runtime": {
    "provider": "anthropic",
    "runtime": "claude-code",
    "executable": "claude",
    "version": "MUST-BE-FROZEN-BEFORE-ASSESSMENT"
  },
  "reasoning_configuration": {
    "effort": null,
    "source": "provider-default-until-frozen"
  },
  "workspace_realization": {
    "kind": "temporary-read-only-evidence-bundle-inside-bwrap"
  },
  "install_mechanism": "none",
  "budgets": {
    "max_turns": 40,
    "timeout_s": 1800
  },
  "containment_policy": {
    "kind": "bwrap-plus-claude-sandbox-v1",
    "workspace_mode": "read-only",
    "mediator_required": false,
    "host_filesystem": "host home/custody hidden; evidence bundle ro; runtime/system roots ro; ephemeral home/tmp",
    "executor_process_network": "no process tool exposed",
    "provider_control_plane_network": "runtime-required only",
    "sandbox_fail_if_unavailable": true,
    "strict_network_allowlist": true,
    "unix_socket_scope": "no host Unix sockets mounted"
  },
  "network_external_write_policy": {
    "evaluator_network": "deny",
    "provider_control_plane": "runtime-required only",
    "external_write": "deny"
  },
  "credential_service_account_policy": {
    "ambient_credentials": "deny by explicit env allow-list plus host-home exclusion"
  },
  "native_tools": [
    "Read",
    "Glob",
    "Grep"
  ],
  "native_allowed_tools": [
    "Read",
    "Glob",
    "Grep"
  ],
  "native_disallowed_tools": [
    "Bash",
    "Edit",
    "Write",
    "NotebookEdit",
    "MultiEdit",
    "Skill",
    "Agent",
    "WebFetch",
    "WebSearch",
    "CronCreate",
    "CronDelete",
    "RemoteTrigger",
    "PushNotification",
    "SendMessage",
    "ShareOnboardingGuide",
    "EnterWorktree",
    "ExitWorktree"
  ],
  "native_surface_requirements": [
    "runtime_capability:interrupt_receipt_v1",
    "runtime_capability:interrupt_cancel_queued_v1",
    "runtime_capability:msg_lifecycle_v1",
    "runtime_capability:mcp_read_resource_v1",
    "runtime_capability:mcp_tool_ui_meta_v1",
    "messaging_socket_path",
    "auto_memory_write"
  ],
  "permission_mode": "plan",
  "provider_managed_unknowns": [
    {
      "name": "provider-backend-shard",
      "classification": "arm-neutral",
      "sensitive_claims": [
        "*"
      ]
    },
    {
      "name": "runtime-build-until-frozen-by-environment",
      "classification": "uncontrolled",
      "sensitive_claims": [
        "*"
      ]
    }
  ]
}
