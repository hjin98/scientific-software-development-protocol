{
  "schema": 1,
  "profile_id": "claude-evaluator-readonly-reference-template",
  "adapter_id": "claude-stream-json-v4",
  "agent_model": "claude-sonnet-5",
  "provider_runtime": {
    "executable": "claude",
    "provider": "anthropic",
    "runtime": "claude-code",
    "version": "MUST-BE-FROZEN-BEFORE-ASSESSMENT"
  },
  "reasoning_configuration": {
    "effort": null,
    "source": "provider-default-until-frozen"
  },
  "workspace_realization": {
    "kind": "temporary-read-only-evidence-bundle"
  },
  "install_mechanism": "none",
  "budgets": {
    "max_turns": 40,
    "timeout_s": 1800
  },
  "containment_policy": {
    "kind": "claude-code-restricted-sandbox-v1",
    "setting_sources": "none",
    "enforcement": "required-before-launch",
    "filesystem_read": "temporary copied evidence bundle only for native file tools (run-project-scoped permission rules and permissions.blockReadsOutsideWorkingDirectories); high-risk host/run-state roots denied",
    "filesystem_write": "deny evaluator tool writes",
    "native_network": "deny",
    "mediator_required": false,
    "ambient_host_home": "deny",
    "ambient_credentials": "deny",
    "runtime_temp": "run-owned project temporary directory",
    "protected_control_files": "settings and strict empty MCP config live under the denied evaluator-private/runtime area outside the evaluator working directory and are digest-checked across launch",
    "denied_read_roots": "harness-private/runtime state, host HOME, /home, /root, /run/user, /proc, /mnt, /media, /srv, /var/tmp",
    "native_file_tools": "run-project-scoped: the adapter alone grants Read as a permission rule scoped to the evidence bundle and sets permissions.blockReadsOutsideWorkingDirectories; a bare or path-argument Read/Glob/Grep in native_allowed_tools is refused",
    "subprocess_env_scrub": "disabled"
  },
  "credential_service_account_policy": {
    "ambient_credentials": "deny",
    "parent_authentication": "zero or one qualification-only auth source mapped explicitly for the Claude parent process",
    "sandboxed_subprocess_credentials": "deny (sandbox.credentials.envVars deny; explicit allow-list child environment)"
  },
  "network_external_write_policy": {
    "external_write": "deny",
    "network": "deny-native-evaluator-network"
  },
  "native_tools": [
    "Read",
    "Glob",
    "Grep"
  ],
  "native_surface_requirements": [
    "runtime_capability:interrupt_receipt_v1",
    "runtime_capability:interrupt_cancel_queued_v1",
    "runtime_capability:msg_lifecycle_v1",
    "runtime_capability:mcp_read_resource_v1",
    "runtime_capability:mcp_tool_ui_meta_v1",
    "messaging_socket_path"
  ],
  "native_allowed_tools": [],
  "native_disallowed_tools": [
    "mcp__*",
    "Bash",
    "Edit",
    "Write",
    "NotebookEdit",
    "MultiEdit",
    "Skill",
    "Agent",
    "WebFetch",
    "WebSearch",
    "SendMessage",
    "ListAgents",
    "RemoteTrigger",
    "CronCreate",
    "CronDelete",
    "CronList",
    "ScheduleWakeup",
    "PushNotification",
    "EnterWorktree",
    "ExitWorktree",
    "Artifact",
    "ArtifactComments",
    "ArtifactData",
    "Workflow",
    "Monitor",
    "DesignSync",
    "ToolSearch",
    "TaskStop",
    "ReportFindings",
    "ShareOnboardingGuide"
  ],
  "permission_mode": "default",
  "provider_managed_unknowns": [
    {
      "classification": "arm-neutral",
      "name": "provider-backend-shard",
      "sensitive_claims": [
        "*"
      ]
    },
    {
      "classification": "uncontrolled",
      "name": "runtime-build-until-frozen-by-environment",
      "sensitive_claims": [
        "*"
      ]
    }
  ],
  "mcp_servers": []
}
