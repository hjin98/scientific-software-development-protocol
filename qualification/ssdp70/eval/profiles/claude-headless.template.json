{
  "schema": 1,
  "profile_id": "claude-headless-reference-template",
  "adapter_id": "claude-stream-json-v3",
  "agent_model": "claude-sonnet-5",
  "provider_runtime": {
    "executable": "claude",
    "provider": "anthropic",
    "runtime": "claude-code",
    "version": "MUST-BE-FROZEN-BEFORE-QUALIFICATION"
  },
  "reasoning_configuration": {
    "effort": null,
    "source": "provider-default-until-frozen"
  },
  "workspace_realization": {
    "kind": "fresh-temporary-project"
  },
  "install_mechanism": "project-local skill package",
  "budgets": {
    "max_turns": 60,
    "timeout_s": 3600
  },
  "containment_policy": {
    "kind": "claude-code-restricted-sandbox-v1",
    "setting_sources": "project",
    "enforcement": "required-before-launch",
    "filesystem_read": "run-owned project/package plus immutable OS runtime reads needed by declared Bash families; host user/custody/run-state roots denied",
    "filesystem_write": "run-owned project only",
    "native_network": "deny",
    "mediator_required": false,
    "ambient_host_home": "deny",
    "ambient_credentials": "deny",
    "runtime_temp": "run-owned project temporary directory",
    "protected_control_files": "settings and strict qualification-owned MCP config live under the denied harness-private/runtime area outside the executor working directory; settings, config, and private MCP server executable are digest-checked across launch; the loaded project settings source is a fixed empty document, hooks are disabled, project .claude is write-denied and re-verified after execution",
    "denied_read_roots": "harness-private/runtime state, host HOME, /home, /root, /run/user, /proc, /mnt, /media, /srv, /var/tmp",
    "mediator_transport": "qualification-owned dependency-free stdio MCP; no executor Unix socket or native network route",
    "mcp_stdio_required": true
  },
  "network_external_write_policy": {
    "external_write": "sandbox-or-mediate",
    "network": "deny-native-executor-network"
  },
  "credential_service_account_policy": {
    "ambient_credentials": "deny",
    "parent_authentication": "zero or one qualification-only auth source mapped explicitly for the Claude parent process",
    "sandboxed_subprocess_credentials": "deny"
  },
  "native_tools": [
    "Skill",
    "Read",
    "Glob",
    "Grep",
    "Edit",
    "Write",
    "Bash",
    "mcp__ssdp70__issue_locations",
    "mcp__ssdp70__issue_search",
    "mcp__ssdp70__issue_show",
    "mcp__ssdp70__issue_create",
    "mcp__ssdp70__issue_comment",
    "mcp__ssdp70__delegate"
  ],
  "native_surface_requirements": [
    "runtime_capability:interrupt_receipt_v1",
    "runtime_capability:interrupt_cancel_queued_v1",
    "runtime_capability:msg_lifecycle_v1",
    "runtime_capability:mcp_read_resource_v1",
    "runtime_capability:mcp_tool_ui_meta_v1",
    "messaging_socket_path",
    "mcp_server:ssdp70"
  ],
  "native_allowed_tools": [
    "Skill",
    "Read",
    "Glob",
    "Grep",
    "Edit",
    "Write",
    "Bash(python:*)",
    "Bash(python3:*)",
    "Bash(git:*)",
    "Bash(ls:*)",
    "Bash(cat:*)",
    "Bash(grep:*)",
    "Bash(find:*)",
    "Bash(head:*)",
    "Bash(tail:*)",
    "Bash(wc:*)",
    "Bash(sed -n:*)",
    "mcp__ssdp70__issue_locations",
    "mcp__ssdp70__issue_search",
    "mcp__ssdp70__issue_show",
    "mcp__ssdp70__issue_create",
    "mcp__ssdp70__issue_comment",
    "mcp__ssdp70__delegate"
  ],
  "native_disallowed_tools": [
    "Agent",
    "WebFetch",
    "WebSearch",
    "SendMessage",
    "ListAgents",
    "RemoteTrigger",
    "CronCreate",
    "CronDelete",
    "CronList",
    "ScheduleWakeup",
    "PushNotification",
    "EnterWorktree",
    "ExitWorktree",
    "Artifact",
    "ArtifactComments",
    "ArtifactData",
    "Workflow",
    "Monitor",
    "DesignSync",
    "ToolSearch",
    "TaskStop",
    "ReportFindings",
    "ShareOnboardingGuide"
  ],
  "permission_mode": "default",
  "pinned_root_instruction_template": "Use the {root} skill. {prompt}",
  "provider_managed_unknowns": [
    {
      "classification": "arm-neutral",
      "name": "provider-backend-shard",
      "sensitive_claims": [
        "*"
      ]
    },
    {
      "classification": "uncontrolled",
      "name": "runtime-build-until-frozen-by-environment",
      "sensitive_claims": [
        "*"
      ]
    }
  ],
  "mcp_servers": [
    {
      "name": "ssdp70",
      "transport": "stdio",
      "server_id": "ssdp70-qualification-stdio-v1",
      "entrypoint": "stub_tools/mediator.py",
      "tools": [
        "mcp__ssdp70__issue_locations",
        "mcp__ssdp70__issue_search",
        "mcp__ssdp70__issue_show",
        "mcp__ssdp70__issue_create",
        "mcp__ssdp70__issue_comment",
        "mcp__ssdp70__delegate"
      ]
    }
  ]
}
