{
  "schema": 1,
  "profile_id": "claude-headless-reference-template",
  "adapter_id": "claude-stream-json-v2",
  "agent_model": "claude-sonnet-5",
  "provider_runtime": {
    "provider": "anthropic",
    "runtime": "claude-code",
    "executable": "claude",
    "version": "MUST-BE-FROZEN-BEFORE-QUALIFICATION"
  },
  "reasoning_configuration": {
    "effort": null,
    "source": "provider-default-until-frozen"
  },
  "workspace_realization": {
    "kind": "fresh-temporary-project-inside-bwrap"
  },
  "install_mechanism": "project-local skill package",
  "budgets": {
    "max_turns": 60,
    "timeout_s": 3600
  },
  "containment_policy": {
    "kind": "bwrap-plus-claude-sandbox-v1",
    "workspace_mode": "read-write",
    "mediator_required": true,
    "host_filesystem": "host home/custody hidden; project rw; runtime/system roots ro; ephemeral home/tmp",
    "executor_process_network": "deny via Claude Bash sandbox; unsandboxed commands forbidden",
    "provider_control_plane_network": "runtime-required only",
    "sandbox_fail_if_unavailable": true,
    "strict_network_allowlist": true,
    "unix_socket_scope": "allowAllUnixSockets only inside bwrap namespace; sole host-mounted socket is qualification mediator"
  },
  "network_external_write_policy": {
    "executor_network": "deny",
    "provider_control_plane": "runtime-required only",
    "external_write": "project-only or qualification mediator"
  },
  "credential_service_account_policy": {
    "ambient_credentials": "deny by explicit env allow-list plus host-home exclusion"
  },
  "native_tools": [
    "Skill",
    "Read",
    "Glob",
    "Grep",
    "Edit",
    "Write",
    "Bash"
  ],
  "native_allowed_tools": [
    "Skill",
    "Read",
    "Glob",
    "Grep",
    "Edit",
    "Write",
    "Bash"
  ],
  "native_disallowed_tools": [
    "Agent",
    "WebFetch",
    "WebSearch",
    "CronCreate",
    "CronDelete",
    "RemoteTrigger",
    "PushNotification",
    "SendMessage",
    "ShareOnboardingGuide",
    "EnterWorktree",
    "ExitWorktree"
  ],
  "native_surface_requirements": [
    "runtime_capability:interrupt_receipt_v1",
    "runtime_capability:interrupt_cancel_queued_v1",
    "runtime_capability:msg_lifecycle_v1",
    "runtime_capability:mcp_read_resource_v1",
    "runtime_capability:mcp_tool_ui_meta_v1",
    "messaging_socket_path",
    "auto_memory_write"
  ],
  "permission_mode": "acceptEdits",
  "pinned_root_instruction_template": "Use the {root} skill. {prompt}",
  "provider_managed_unknowns": [
    {
      "name": "provider-backend-shard",
      "classification": "arm-neutral",
      "sensitive_claims": [
        "*"
      ]
    },
    {
      "name": "runtime-build-until-frozen-by-environment",
      "classification": "uncontrolled",
      "sensitive_claims": [
        "*"
      ]
    }
  ]
}
