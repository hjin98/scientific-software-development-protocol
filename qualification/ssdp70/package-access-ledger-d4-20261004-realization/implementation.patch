+    lo = earlier[-1].get("position", start) if earlier else start
+    hi = later[0].get("position", start) - 1 if later else end
+    if hi < lo or not earlier:
+        lo, hi = start, end
+    return {"start": lo, "end": hi, "timing_loss": False}
