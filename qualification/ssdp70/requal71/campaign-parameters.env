# Protocol 7.1 requalification parameters. ANALYST-OWNED: the operator sources this file and never edits it.
# Every UNDECIDED value comes from a stakeholder decision or a phase output named in PROTOCOL-7.1-REQUALIFICATION-PLAN.md §3-§4.
# After any edit the analyst regenerates tool-pins.sha256 (runbook R0 verifies it).

REPO=/home/samjin/agent-skills/scientific-software-development-protocol
PY=/usr/bin/python3
RQ="$PY $REPO/qualification/ssdp70/eval/requal71.py"
EVAL_DIR=$REPO/qualification/ssdp70/eval
SOURCE_PROFILE=$EVAL_DIR/profiles/omp-primary-flash-executor.json
SOURCE_CAPS=$EVAL_DIR/capabilities/omp-headless.json
DISCLOSED=$REPO/qualification/ssdp70/requal71/disclosed-material.json
LINEAGE=$REPO/qualification/ssdp70/requal71/prior-campaigns.json

# Arms (plan §1). p65/p66 accepted comparators; p71 per SD-1 (STAKEHOLDER-DECISION-2026-10-06-PROTOCOL-7.1-REQUALIFICATION.md).
P65_ARM=p65=7f7b5e24858e813e45ace867a7f8ea5180f43bf0:6.5.0
P65_SHA=p65=7d61d8b7b19dfe40714e71daa2c46d0e4cdd62efebd96b8e96dfe3f33550429b
P66_ARM=p66=22f4bdba53795da3a6f13f162529f3a843fc37ae:6.6.0
P66_SHA=p66=e6d960a866fb794382fa5fdaa3e351681d292803dd035e5d4786a981a2a1e083
P71_ARM=p71=58fd67ba15c937040f51e56dc26f30ad7a907ac3:7.1.0
P71_SHA=p71=7a86ea4011034f8abf793c1c06d523577356a5b1a7167b267dda53e567a2892e

# Wall-clock timeouts and parallelism (SD-3, adopted 2026-10-06). Turn caps are contract-fixed, not here.
TIMEOUT_MAIN=2400
TIMEOUT_BURDEN=2400
TIMEOUT_ROUTING=900
TIMEOUT_ORDINARY=600
PARALLEL=4

# Locations (SD-2 / P3). Both outside the repository; WORK must lie beneath ~/ssdp70-omp-stagef/qualification/ (an approved OMP realization root; e.g. ~/ssdp70-omp-stagef/qualification/requal71-<date>).
CUSTODY=/home/samjin/ssdp71-fixture-custody
WORK=/home/samjin/ssdp70-omp-stagef/qualification/requal71-20261006

# Admissions (P5): ADMITTED bundles finalized by the independent checker.
ADM_MAIN=UNDECIDED
ADM_BURDEN=UNDECIDED
ADM_ROUTING=UNDECIDED
ADM_ORDINARY=UNDECIDED
EVAL_PROFILE=UNDECIDED
EVAL_CAPS=UNDECIDED
EVAL_ADMISSION=UNDECIDED

# Custodian deliverable C-4: the complete aggregate command, quoted, reading $WORK/accounting-manifest.json.
AGGREGATE_CMD=UNDECIDED
