name: Protocol build check

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install validation dependencies
        run: python -m pip install -r source/requirements-validation.txt
      - name: Run protocol regression tests
        run: python -m unittest discover -s tests -v
      - name: Build canonical skill packages once
        run: python source/build_skills.py --output /tmp/protocol-dist
      - name: Validate generated skill packages independently
        run: python source/validate_packages.py --dist /tmp/protocol-dist
      - name: Verify committed distribution parity
        run: python source/check_dist.py --expected /tmp/protocol-dist --committed dist
      - name: Check patch whitespace
        run: git diff --check

  orchestrator-core:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install orchestrator Core and its development dependencies
        run: >-
          python -m pip install ./orchestrator
          -r orchestrator/requirements-dev.txt
      - name: Verify the packaged Protocol snapshot matches canonical source
        run: python orchestrator/scripts/generate_protocol_snapshot.py --check
      - name: Run orchestrator Core acceptance suite
        run: python orchestrator/scripts/run_core_tests.py

  protocol64-stage-f-closeout:
    if: github.event_name == 'pull_request' && github.event.pull_request.head.ref == 'ssdp-6.4-axiomatic-definition-traceability'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
      - name: Gate exact closeout trigger
        id: gate
        shell: bash
        run: |
          set -euo pipefail
          msg="$(git log -1 --pretty=%s)"
          if [ "$msg" = "Execute Protocol 6.4 Stage F closeout" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
          else
            echo "run=false" >> "$GITHUB_OUTPUT"
          fi
      - uses: actions/setup-python@v5
        if: steps.gate.outputs.run == 'true'
        with:
          python-version: '3.12'
      - name: Install Stage-F dependencies
        if: steps.gate.outputs.run == 'true'
        run: |
          python -m pip install pyyaml -r source/requirements-validation.txt
          python -m pip install ./orchestrator -r orchestrator/requirements-dev.txt
      - name: Construct Stage-F closeout tree
        if: steps.gate.outputs.run == 'true'
        run: |
          set -euo pipefail
          python - <<'PY'
          import yaml
          from pathlib import Path
          data = yaml.safe_load(Path('.github/workflows/temporary-protocol64-stage-f-final7.yml').read_text())
          step = next(s for s in data['jobs']['final7']['steps'] if s.get('name') == 'Construct final6 tree and close exact remaining unit oracles')
          Path('/tmp/stage-f-construct.sh').write_text(step['run'])
          PY
          bash /tmp/stage-f-construct.sh
      - name: Full Stage-F acceptance
        if: steps.gate.outputs.run == 'true'
        run: |
          set -euxo pipefail
          python -m unittest discover -s tests -v
          python source/project_engineering_memory.py PROJECT-ENGINEERING-MEMORY.md
          rm -rf /tmp/protocol-dist
          python source/build_skills.py --output /tmp/protocol-dist
          python source/validate_packages.py --dist /tmp/protocol-dist
          python source/check_dist.py --expected /tmp/protocol-dist --committed dist
          python orchestrator/scripts/generate_protocol_snapshot.py --check
          python orchestrator/scripts/run_core_tests.py
          git diff --check
      - name: Publish verified Stage-F closeout
        if: steps.gate.outputs.run == 'true'
        run: |
          set -euxo pipefail
          git config user.name 'Protocol 6.4 lifecycle automation'
          git config user.email 'protocol64-lifecycle@users.noreply.github.com'
          git checkout 50a7158f7757c8f2cb2be7baa82d7a11537dde85 -- .github/workflows/protocol-check.yml
          find .github/workflows -maxdepth 1 -type f -name 'temporary-protocol64-stage-f-*.yml' -print0 | xargs -0 -r git rm
          git rm --ignore-unmatch .github/workflows/temporary-protocol64-stage-f-bootstrap-marker.txt
          git rm --ignore-unmatch .github/workflows/protocol-check-stage-f-bootstrap.yml
          git rm --ignore-unmatch .github/workflows/protocol-check-instrumented.tmp
          find qualification/ssdp6 -maxdepth 1 -type f -name 'STAGE-F-DIAGNOSTIC*PROTOCOL-6.4.txt' -print0 | xargs -0 -r git rm --ignore-unmatch
          git add -A
          git diff --cached --check
          git commit -m 'Close Protocol 6.4 lifecycle'
          git push origin HEAD:ssdp-6.4-axiomatic-definition-traceability
